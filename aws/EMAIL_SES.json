{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:us-east-2:811106941521:identity/xunchenecon@gmail.com",
      "Condition": {
        "StringEquals": {
          "ses:FromAddress": "xunchenecon@gmail.com"
        },
        "ForAllValues:StringEquals": {
          "ses:Recipients": [
            "xunchenecon@gmail.com"
          ]
        }
      }
    }
  ]
}
